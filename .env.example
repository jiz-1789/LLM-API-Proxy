# GitHub 发布配置
# 复制此文件为 .env 并填入你的 Token
# 注意：.env 文件不应提交到仓库（已在 .gitignore 中配置）

# GitHub Personal Access Token（需要 repo 权限）
# 获取方式：https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO_OWNER=jiz-1789
GITHUB_REPO_NAME=LLM-API-Proxy

# Gitee 发布配置
# 获取方式：https://gitee.com/profile/personal_access_tokens
GITEE_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITEE_REPO_OWNER=yilichenaiosi
GITEE_REPO_NAME=LLM-API-Proxy
GITEE_TARGET_BRANCH=main
